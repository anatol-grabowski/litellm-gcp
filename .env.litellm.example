# =============================================================================
# .env.litellm — runtime environment for the LiteLLM proxy container itself
# =============================================================================
# Copy this file to .env.litellm and edit the copy; the local file is git-ignored.
# Passed into the container via --env-file. Values here are readable from
# config/config.yaml using the `os.environ/VAR_NAME` syntax.

# Bearer token clients must send to call the proxy (Authorization: Bearer ...).
# Leave as CHANGE_ME (or blank) and deploy.sh will generate a random key and
# write it back into this file automatically on first run.
LITELLM_MASTER_KEY=CHANGE_ME

# A Postgres container now runs alongside LiteLLM on the same VM (see
# .env.db), so DB-backed storage is on: this is what makes /ui, virtual
# keys, and per-user/per-key/per-team budgets work. DATABASE_URL itself
# isn't set here — deploy.sh assembles it from .env.db at deploy time and
# injects it directly into the container, so the Postgres password only
# needs to live in one file.
STORE_MODEL_IN_DB=True

# Encrypts/decrypts stored provider API keys and other secrets in Postgres.
# Leave as CHANGE_ME (or blank) and deploy.sh will generate and save one on
# first run, same as LITELLM_MASTER_KEY. WARNING: unlike the master key,
# this cannot be changed later without losing access to anything already
# encrypted with it — back it up once it's generated.
LITELLM_SALT_KEY=CHANGE_ME

# Port the proxy listens on inside the container.
# Must match LITELLM_PORT in .env.gcp.
PORT=4000

# --- Upstream LLM provider credentials ---------------------------------------
# Fill in the providers you want to route through this gateway.
# Referenced from config/config.yaml as os.environ/OPENAI_API_KEY etc.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
