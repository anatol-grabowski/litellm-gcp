# =============================================================================
# .env.gcp — Google Cloud deployment settings for the LiteLLM proxy VM
# =============================================================================
# Copy this file to .env.gcp and edit the copy; the local file is git-ignored.
# Consumed by scripts/deploy.sh and scripts/teardown.sh.
# Leave PROJECT_ID blank to use whatever `gcloud config get-value project`
# currently points to.

# --- GCP project & location -------------------------------------------------
PROJECT_ID=
REGION=europe-north1
ZONE=europe-north1-a
# us-central1 / us-east1 / us-west1 are the regions eligible for the GCE
# free-tier e2-micro instance-hour allowance — note that no longer applies
# once MACHINE_TYPE is e2-small (see below), but the disk allowance still
# does.

# --- Compute instance --------------------------------------------------------
INSTANCE_NAME=litellm-proxy
# e2-small, not e2-micro: this deployment now also runs a Postgres container
# for budgets/virtual-keys/spend-tracking alongside LiteLLM, and the pair
# reliably needs more than the e2-micro's 1GB RAM. e2-small (2GB) is the
# minimum machine type that runs both containers without OOM risk.
MACHINE_TYPE=e2-small
BOOT_DISK_SIZE_GB=10
# pd-standard is the cheapest disk type; 10GB is the practical minimum for
# Container-Optimized OS and fits inside the 30GB/month free-tier allowance.
BOOT_DISK_TYPE=pd-standard
IMAGE_FAMILY=cos-stable
IMAGE_PROJECT=cos-cloud

# --- Networking ---------------------------------------------------------------
NETWORK=default
SUBNET=default
NETWORK_TAG=litellm-server
FW_RULE_NAME=allow-litellm
# 0.0.0.0/0 = open to the whole internet, as requested. Narrow this to your
# own IP range if you want to restrict access instead.
ALLOWED_SOURCE_RANGE=0.0.0.0/0
LITELLM_PORT=4000

# --- Container image ----------------------------------------------------------
# The "-database" variant is required (not the plain "litellm" image): it
# bundles the Prisma client that talks to Postgres. Without it, budgets,
# virtual keys, and the /ui login stay broken even with DATABASE_URL set.
# Pinned to the latest stable LiteLLM release as of 2026-07-11.
# Check https://github.com/BerriAI/litellm/releases for newer tags.
LITELLM_IMAGE=ghcr.io/berriai/litellm-database:v1.91.2

# Postgres image used for the on-VM database container.
POSTGRES_IMAGE=postgres:17-alpine
