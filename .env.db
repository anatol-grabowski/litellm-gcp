# =============================================================================
# .env.db — credentials for the on-VM Postgres container backing LiteLLM's
# budgets, virtual keys, spend tracking, and /ui login.
# =============================================================================
# Consumed by the Postgres container directly, and by deploy.sh to assemble
# DATABASE_URL for the LiteLLM container. Keeping it in its own file means
# the password isn't duplicated across .env.litellm and here.

POSTGRES_USER=litellm
POSTGRES_DB=litellm
# Leave as CHANGE_ME (or blank) and deploy.sh will generate and save a
# random password here on first run.
POSTGRES_PASSWORD=CHANGE_ME
